<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
      xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance">
    <entity
            table="products"
            name="App\Product\Domain\Model\Product"
            repository-class="App\Product\Infrastructure\Persistence\OrmProductRepository"
    >
        <id name="id" type="string" length="36"/>
        <field name="reference" type="string" length="255" nullable="false" unique="true"/>
        <field name="name" type="string" length="255" nullable="false"/>
        <field name="price" type="decimal" precision="10" scale="2" nullable="false"/>
        <field name="status" enum-type="App\Product\Domain\Model\ProductStatus" nullable="false"/>
        <field name="description" type="string" length="255" nullable="false"/>
        <field name="createdAt" column="created_at" type="datetime_immutable" nullable="false"/>
    </entity>
</doctrine-mapping>