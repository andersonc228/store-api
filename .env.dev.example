APP_ENV=dev
APP_SECRET=generar_un_secret_aleatorio_aqui
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

DATABASE_URL="mysql://user:password@127.0.0.1:3306/db_name?serverVersion=8.0.32&charset=utf8mb4"

MAILER_DSN=null://null

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=cambiar_por_una_frase_de_paso_segura

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL="redis://127.0.0.1:6379?db=0"
